---
import Base from "../../../layouts/Base.astro";
import ArtworkGrid from "../../../components/ArtworkGrid.astro";
import ViewSwitch from "../../../components/ViewSwitch.astro";
import Pagination from "../../../components/Pagination.astro";
import { getClassificationFacets, getByClassificationSlug } from "../../../data/gallery";

export function getStaticPaths({ paginate }: { paginate: any }) {
  return getClassificationFacets().flatMap((f) =>
    paginate(getByClassificationSlug(f.slug), { params: { slug: f.slug }, pageSize: 60 })
  );
}

const { slug } = Astro.params;
const { page } = Astro.props;
const total = page.total;
const label = page.data[0]?.classification ?? slug;
---
<Base title={`${label} — Open Collection Archive`}>
  <p class="crumb"><a href="/styles/">← All styles</a></p>
  <h1>{label}</h1>
  <p class="count">{total.toLocaleString()} work{total === 1 ? "" : "s"}</p>
  <ViewSwitch base={`/styles/${slug}`} active="catalog" />
  <ArtworkGrid artworks={page.data} />
  <Pagination page={page} base={`/styles/${slug}`} />
</Base>

<style>
  .crumb { font-size: 0.85rem; margin-bottom: 8px; }
  .crumb a { color: var(--muted); text-decoration: none; }
  .crumb a:hover { color: var(--accent); }
  .count { color: var(--muted); font-size: 0.9rem; margin-top: -4px; }
</style>
