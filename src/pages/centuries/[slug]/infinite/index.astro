---
import Base from "../../../../layouts/Base.astro";
import ViewSwitch from "../../../../components/ViewSwitch.astro";
import InfiniteView from "../../../../components/InfiniteView.astro";
import { getCenturyFacets, getByCenturySlug } from "../../../../data/gallery";

export function getStaticPaths() {
  return getCenturyFacets().map((f) => ({ params: { slug: f.slug } }));
}

const { slug } = Astro.params;
const works = getByCenturySlug(slug as string);
const label = works[0]?.century ?? slug;
---
<Base title={`${label} — Infinite View`}>
  <p class="crumb"><a href="/centuries/">← All periods</a></p>
  <h1>{label}</h1>
  <p class="count">{works.length.toLocaleString()} work{works.length === 1 ? "" : "s"}</p>
  <ViewSwitch base={`/centuries/${slug}`} active="infinite" />
  <InfiniteView artworks={works} />
</Base>

<style>
  .crumb { font-size: 0.85rem; margin-bottom: 8px; }
  .crumb a { color: var(--muted); text-decoration: none; }
  .crumb a:hover { color: var(--accent); }
  .count { color: var(--muted); font-size: 0.9rem; margin-top: -4px; }
</style>
