---
import type { Artwork } from "../data/gallery";
interface Props {
  artworks: Artwork[];
}
const { artworks } = Astro.props as Props;
const payload = artworks.map((a) => ({
  id: a.id,
  title: a.title,
  artist: a.artist,
  thumb: `${a.iiif_url}/full/!400,400/0/default.jpg`,
  alt: a.alt_text || a.title,
}));
---
<div id="shuffle-root" data-artworks={JSON.stringify(payload)}>
  <button id="shuffle-btn" type="button">Shuffle again</button>
  <div id="shuffle-grid" class="grid"></div>
</div>

<style>
  #shuffle-btn {
    display: inline-block;
    margin-bottom: 18px;
    padding: 8px 16px;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--fg);
    color: var(--bg);
    border: none;
    border-radius: 3px;
    cursor: pointer;
  }
  #shuffle-btn:hover { background: var(--accent); }
  .grid {
    columns: 5 220px;
    column-gap: 18px;
  }
  @media (max-width: 640px) {
    .grid { columns: 2 160px; }
  }
  .grid :global(a.card) {
    display: block;
    text-decoration: none;
    color: inherit;
    break-inside: avoid;
    margin-bottom: 18px;
  }
  .grid :global(.thumb-wrap) {
    background: #eae6db;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .grid :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .grid :global(.meta) { padding: 8px 2px 0; }
  .grid :global(.title) {
    margin: 0;
    font-family: var(--serif);
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .grid :global(.artist) {
    margin: 2px 0 0;
    font-size: 0.78rem;
    color: var(--muted);
  }
</style>

<script>
  interface ArtworkPayload {
    id: string;
    title: string;
    artist: string;
    thumb: string;
    alt: string;
  }

  const root = document.getElementById("shuffle-root")!;
  const grid = document.getElementById("shuffle-grid")!;
  const btn = document.getElementById("shuffle-btn")!;
  const all: ArtworkPayload[] = JSON.parse(root.dataset.artworks || "[]");

  function shuffledCopy<T>(arr: T[]): T[] {
    const copy = [...arr];
    for (let i = copy.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
  }

  function render(items: ArtworkPayload[]) {
    grid.innerHTML = "";
    const frag = document.createDocumentFragment();
    for (const a of items.slice(0, 60)) {
      const card = document.createElement("a");
      card.className = "card";
      card.href = `/artwork/${a.id}/`;
      card.innerHTML = `
        <div class="thumb-wrap"><img src="${a.thumb}" alt="${a.alt.replace(/"/g, "&quot;")}" loading="lazy" /></div>
        <div class="meta">
          <p class="title">${a.title}</p>
          <p class="artist">${a.artist}</p>
        </div>
      `;
      frag.appendChild(card);
    }
    grid.appendChild(frag);
  }

  btn.addEventListener("click", () => render(shuffledCopy(all)));
  render(shuffledCopy(all));
</script>
