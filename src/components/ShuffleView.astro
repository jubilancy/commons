---
import { shardCount } from "../data/gallery";
interface Props {
  scope: string;
  total: number;
}
const { scope, total } = Astro.props as Props;
---
<div id="shuffle-root" data-scope={scope} data-pages={shardCount(total)}>
  <button id="shuffle-btn" type="button">Shuffle again</button>
  <div id="shuffle-grid" class="grid"></div>
</div>

<style>
  #shuffle-btn {
    display: inline-block;
    margin-bottom: 18px;
    padding: 8px 16px;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--fg);
    color: var(--bg);
    border: none;
    border-radius: 3px;
    cursor: pointer;
  }
  #shuffle-btn:hover { background: var(--accent); }
  .grid {
    columns: 5 220px;
    column-gap: 18px;
  }
  @media (max-width: 640px) {
    .grid { columns: 2 160px; }
  }
  .grid :global(a.card) {
    display: block;
    text-decoration: none;
    color: inherit;
    break-inside: avoid;
    margin-bottom: 18px;
  }
  .grid :global(.thumb-wrap) {
    background: #eae6db;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .grid :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .grid :global(.meta) { padding: 8px 2px 0; }
  .grid :global(.title) {
    margin: 0;
    font-family: var(--serif);
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .grid :global(.artist) {
    margin: 2px 0 0;
    font-size: 0.78rem;
    color: var(--muted);
  }
</style>

<script>
  import { fetchShard, renderCard, type CardPayload } from "../scripts/cards";

  const root = document.getElementById("shuffle-root")!;
  const grid = document.getElementById("shuffle-grid")!;
  const btn = document.getElementById("shuffle-btn")!;
  const scope = root.dataset.scope!;
  const pages = Number(root.dataset.pages);

  const SHOW = 60;
  const SHARDS_PER_SHUFFLE = 3; // sample a few random shards rather than loading the whole scope

  function shuffled<T>(arr: T[]): T[] {
    const copy = [...arr];
    for (let i = copy.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
  }

  async function shuffle() {
    btn.setAttribute("disabled", "");
    try {
      const picks = shuffled(Array.from({ length: pages }, (_, i) => i)).slice(0, SHARDS_PER_SHUFFLE);
      const items: CardPayload[] = (await Promise.all(picks.map((n) => fetchShard(scope, n)))).flat();
      grid.replaceChildren(...shuffled(items).slice(0, SHOW).map(renderCard));
    } catch (e) {
      console.error(e);
    } finally {
      btn.removeAttribute("disabled");
    }
  }

  btn.addEventListener("click", shuffle);
  shuffle();
</script>
