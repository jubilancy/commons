---
import type { Artwork } from "../data/gallery";
interface Props {
  artworks: Artwork[];
}
const { artworks } = Astro.props as Props;
// Embed a lightweight payload (id, title, artist, thumb) for the client script.
const payload = artworks.map((a) => ({
  id: a.id,
  title: a.title,
  artist: a.artist,
  thumb: `${a.iiif_url}/full/!400,400/0/default.jpg`,
  alt: a.alt_text || a.title,
}));
---
<div id="infinite-root" data-artworks={JSON.stringify(payload)}>
  <div id="infinite-grid" class="grid"></div>
  <p id="infinite-end" class="end-msg" hidden>You've reached the end — {artworks.length} works shown.</p>
</div>

<style>
  .grid {
    columns: 5 220px;
    column-gap: 18px;
  }
  @media (max-width: 640px) {
    .grid { columns: 2 160px; }
  }
  .grid :global(a.card) {
    display: block;
    text-decoration: none;
    color: inherit;
    break-inside: avoid;
    margin-bottom: 18px;
  }
  .grid :global(.thumb-wrap) {
    background: #eae6db;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .grid :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .grid :global(.meta) { padding: 8px 2px 0; }
  .grid :global(.title) {
    margin: 0;
    font-family: var(--serif);
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .grid :global(.artist) {
    margin: 2px 0 0;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .end-msg {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    padding: 24px 0;
  }
</style>

<script>
  interface ArtworkPayload {
    id: string;
    title: string;
    artist: string;
    thumb: string;
    alt: string;
  }

  const root = document.getElementById("infinite-root")!;
  const grid = document.getElementById("infinite-grid")!;
  const endMsg = document.getElementById("infinite-end")!;
  const all: ArtworkPayload[] = JSON.parse(root.dataset.artworks || "[]");

  const PAGE_SIZE = 20;
  let loaded = 0;

  function renderNext() {
    const next = all.slice(loaded, loaded + PAGE_SIZE);
    if (next.length === 0) {
      endMsg.hidden = false;
      observer.disconnect();
      return;
    }
    const frag = document.createDocumentFragment();
    for (const a of next) {
      const card = document.createElement("a");
      card.className = "card";
      card.href = `/artwork/${a.id}/`;
      card.innerHTML = `
        <div class="thumb-wrap"><img src="${a.thumb}" alt="${a.alt.replace(/"/g, "&quot;")}" loading="lazy" /></div>
        <div class="meta">
          <p class="title">${a.title}</p>
          <p class="artist">${a.artist}</p>
        </div>
      `;
      frag.appendChild(card);
    }
    grid.appendChild(frag);
    loaded += next.length;
  }

  const sentinel = document.createElement("div");
  sentinel.style.height = "1px";
  root.appendChild(sentinel);

  const observer = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting) renderNext();
    },
    { rootMargin: "600px" }
  );
  observer.observe(sentinel);

  renderNext(); // first page immediately
</script>
