---
import { shardCount } from "../data/gallery";
interface Props {
  scope: string; // "all" | "artists/<slug>" | ...
  total: number;
}
const { scope, total } = Astro.props as Props;
---
<div id="infinite-root" data-scope={scope} data-pages={shardCount(total)}>
  <div id="infinite-grid" class="grid"></div>
  <p id="infinite-end" class="end-msg" hidden>You've reached the end — {total} works shown.</p>
</div>

<style>
  .grid {
    columns: 5 220px;
    column-gap: 18px;
  }
  @media (max-width: 640px) {
    .grid { columns: 2 160px; }
  }
  .grid :global(a.card) {
    display: block;
    text-decoration: none;
    color: inherit;
    break-inside: avoid;
    margin-bottom: 18px;
  }
  .grid :global(.thumb-wrap) {
    background: #eae6db;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .grid :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .grid :global(.meta) { padding: 8px 2px 0; }
  .grid :global(.title) {
    margin: 0;
    font-family: var(--serif);
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .grid :global(.artist) {
    margin: 2px 0 0;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .end-msg {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    padding: 24px 0;
  }
</style>

<script>
  import { fetchShard, renderCard } from "../scripts/cards";

  const root = document.getElementById("infinite-root")!;
  const grid = document.getElementById("infinite-grid")!;
  const endMsg = document.getElementById("infinite-end")!;
  const scope = root.dataset.scope!;
  const pages = Number(root.dataset.pages);

  let next = 0;
  let loading = false;

  async function loadNext() {
    if (loading) return;
    if (next >= pages) {
      endMsg.hidden = false;
      observer.disconnect();
      return;
    }
    loading = true;
    try {
      const items = await fetchShard(scope, next);
      const frag = document.createDocumentFragment();
      for (const a of items) frag.appendChild(renderCard(a));
      grid.appendChild(frag);
      next++;
    } catch (e) {
      console.error(e);
    } finally {
      loading = false;
    }
  }

  const sentinel = document.createElement("div");
  sentinel.style.height = "1px";
  root.appendChild(sentinel);

  const observer = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting) loadNext();
    },
    { rootMargin: "600px" }
  );
  observer.observe(sentinel);

  loadNext(); // first page immediately
</script>
